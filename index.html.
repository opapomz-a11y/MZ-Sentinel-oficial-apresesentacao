            rel="noopener noreferrer"
          >
            Explorar plataforma ↗
          </a>
        </div>

        <div class="card">
          <span class="tag">Entretenimento digital</span>

          <div class="icon">▶</div>

          <h3>Mzinistream</h3>

          <p>
            Projecto de plataforma digital orientado para
            entretenimento e transmissão de conteúdos,
