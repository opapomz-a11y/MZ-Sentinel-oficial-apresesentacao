<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="MZ-SENTINEL — Plataforma de análise, correlação e apoio à investigação. Protótipo tecnológico independente desenvolvido em Moçambique por Lucas Cristiano Manjate.">

  <meta name="author" content="Lucas Cristiano Manjate">
  <meta name="theme-color" content="#081321">

  <title>MZ-SENTINEL | Plataforma de Análise e Inteligência</title>

  <style>
    :root {
      --bg: #081321;
      --bg-light: #101f32;
      --card: #13243a;
      --card-light: #192d45;
      --gold: #d8ad57;
      --gold-light: #f0ce83;
      --white: #f5f7fa;
      --muted: #a9b7c8;
      --green: #39c98a;
      --blue: #55a8ed;
      --border: rgba(255,255,255,.10);
      --radius: 16px;
      --max-width: 1200px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--white);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(92%, var(--max-width));
      margin: auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(8,19,33,.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .navbar {
      min-height: 75px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .brand {
      font-size: 21px;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gold);
    }

    .brand span {
      display: block;
      color: var(--muted);
      font-size: 9px;
      letter-spacing: 3px;
      font-weight: normal;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 19px;
      flex-wrap: wrap;
    }

    nav a {
      font-size: 12px;
      color: var(--muted);
      transition: .3s;
    }

    nav a:hover {
      color: var(--gold);
    }

    .hero {
      min-height: 620px;
      display: flex;
      align-items: center;
      background:
        radial-gradient(circle at 80% 20%, rgba(216,173,87,.12), transparent 35%),
        linear-gradient(120deg, #081321, #10243a);
      border-bottom: 1px solid var(--border);
    }

    .hero-content {
      max-width: 850px;
      padding: 100px 0;
    }

    .eyebrow {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 12px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(40px, 7vw, 76px);
      line-height: 1.05;
      margin-bottom: 25px;
      letter-spacing: -2px;
    }

    h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 750px;
      color: var(--muted);
      font-size: 18px;
      margin-bottom: 30px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 22px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: bold;
      transition: .3s;
    }

    .btn-primary {
      background: var(--gold);
      color: #101923;
    }

    .btn-primary:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
    }

    .btn-outline {
      border: 1px solid var(--gold);
      color: var(--gold);
    }

    .btn-outline:hover {
      background: rgba(216,173,87,.1);
    }

    section {
      padding: 85px 0;
      border-bottom: 1px solid var(--border);
    }

    .section-heading {
      margin-bottom: 40px;
      max-width: 800px;
    }

    .section-number {
      color: var(--gold);
      font-size: 12px;
      letter-spacing: 3px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    h2 {
      font-size: clamp(28px, 4vw, 42px);
      margin-bottom: 15px;
    }

    h3 {
      font-size: 19px;
      margin-bottom: 12px;
    }

    .section-heading p,
    .text-muted {
      color: var(--muted);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .grid-two {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 25px;
      transition: .3s;
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: rgba(216,173,87,.45);
    }

    .card p {
      color: var(--muted);
      font-size: 14px;
    }

    .icon {
      font-size: 28px;
      margin-bottom: 15px;
    }

    .tag {
      display: inline-block;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--gold);
      background: rgba(216,173,87,.12);
      padding: 5px 9px;
      border-radius: 20px;
      margin-bottom: 12px;
    }

    .highlight {
      background: linear-gradient(135deg, #172d46, #102137);
      border-left: 4px solid var(--gold);
      padding: 25px;
      border-radius: 10px;
      margin-top: 25px;
    }

    .highlight p {
      color: var(--muted);
    }

    .profile {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 30px;
      align-items: start;
    }

    .profile-box {
      background: linear-gradient(145deg, #1a3049, #0f1d30);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 30px;
    }

    .profile-initials {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: rgba(216,173,87,.15);
      border: 2px solid var(--gold);
      display: grid;
      place-items: center;
      color: var(--gold);
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    .profile-box p {
      color: var(--muted);
      font-size: 13px;
    }

    .project-link {
      display: inline-block;
      margin-top: 18px;
      color: var(--gold);
      font-size: 13px;
      font-weight: bold;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 4px;
    }

    .project-link:hover {
      color: var(--gold-light);
    }

    .architecture {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      margin-top: 30px;
    }

    .architecture-box {
      width: min(100%, 650px);
      text-align: center;
      padding: 18px;
      border: 1px solid var(--gold);
      background: var(--card);
      border-radius: 10px;
    }

    .architecture-box strong {
      color: var(--gold);
      display: block;
    }

    .architecture-box small {
      color: var(--muted);
    }

    .arrow {
      color: var(--gold);
      font-size: 24px;
    }

    .status {
      display: inline-block;
      font-size: 11px;
      padding: 5px 10px;
      border-radius: 20px;
      margin-top: 12px;
    }

    .status-current {
      background: rgba(57,201,138,.12);
      color: var(--green);
    }

    .status-future {
      background: rgba(85,168,237,.12);
      color: var(--blue);
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-top: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
    }

    th, td {
      padding: 15px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }

    th {
      color: var(--gold);
      background: #172940;
    }

    td {
      color: var(--muted);
    }

    tr:last-child td {
      border-bottom: none;
    }

    .total-row td {
      color: var(--gold);
      font-weight: bold;
      background: rgba(216,173,87,.07);
    }

    .notice {
      padding: 18px;
      background: rgba(216,173,87,.08);
      border: 1px solid rgba(216,173,87,.3);
      border-radius: 10px;
      color: var(--muted);
      font-size: 13px;
      margin-top: 25px;
    }

    .warning {
      border-left: 4px solid #e0a34d;
      background: rgba(224,163,77,.08);
      padding: 20px;
      border-radius: 8px;
      margin-top: 20px;
    }

    .warning p {
      color: var(--muted);
      font-size: 13px;
    }

    .footer {
      padding: 45px 0;
      text-align: center;
      background: #060e19;
    }

    .footer p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 8px;
    }

    .footer strong {
      color: var(--gold);
    }

    .print-button {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 999;
      border: none;
      cursor: pointer;
      border-radius: 30px;
      padding: 13px 20px;
      background: var(--gold);
      color: #101923;
      font-weight: bold;
      box-shadow: 0 5px 20px rgba(0,0,0,.3);
    }

    @media (max-width: 900px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .profile {
        grid-template-columns: 1fr;
      }

      .navbar {
        flex-direction: column;
        padding: 15px 0;
      }

      nav {
        justify-content: center;
      }
    }

    @media (max-width: 600px) {
      .grid,
      .grid-two {
        grid-template-columns: 1fr;
      }

      .hero {
        min-height: auto;
      }

      .hero-content {
        padding: 75px 0;
      }

      nav {
        gap: 12px;
      }

      nav a {
        font-size: 11px;
      }

      section {
        padding: 60px 0;
      }

      .print-button {
        bottom: 12px;
        right: 12px;
        padding: 11px 15px;
      }
    }

    @media print {
      :root {
        --bg: #ffffff;
        --white: #172333;
        --muted: #465466;
        --card: #f2f5f8;
        --border: #d5dce5;
      }

      body {
        background: white;
        color: #172333;
      }

      header,
      .print-button,
      .hero-actions {
        display: none !important;
      }

      .hero {
        min-height: auto;
        background: white;
        border-bottom: 2px solid #d8ad57;
      }

      .hero-content {
        padding: 35px 0;
      }

      .hero p,
      .card p,
      .section-heading p,
      .text-muted,
      .profile-box p,
      td {
        color: #465466;
      }

      section {
        padding: 35px 0;
        break-inside: avoid;
      }

      .card,
      .profile-box,
      .architecture-box {
        background: #f4f6f8;
        color: #172333;
        break-inside: avoid;
      }

      h1, h2, h3 {
        color: #172333;
      }

      h1 span,
      .eyebrow,
      .section-number,
      .brand,
      .architecture-box strong {
        color: #9b742d;
      }

      a {
        color: #72551d;
      }

      .footer {
        background: white;
        border-top: 1px solid #ddd;
      }

      .footer p {
        color: #465466;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container navbar">

    <a href="#inicio" class="brand">
      MZ-SENTINEL
      <span>ANALYTICS & INTELLIGENCE</span>
