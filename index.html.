  <!-- 05. FUNCIONALIDADES -->

  <section id="funcionalidades">
    <div class="container">

      <div class="section-heading">
        <div class="section-number">04 — CAPACIDADES</div>
        <h2>Módulos funcionais</h2>

        <p>
          O protótipo contempla diferentes áreas de organização
          e análise de informação.
        </p>
      </div>

      <div class="grid">

        <div class="card">
          <h3>01. Analytics Dashboard</h3>
          <p>
            Painel de visualização de indicadores e informação
            analítica.
          </p>
        </div>

        <div class="card">
          <h3>02. Correlations</h3>
          <p>
            Apresentação de relações potenciais entre registos.
          </p>
        </div>

        <div class="card">
          <h3>03. Occurrence Analysis</h3>
          <p>
            Organização e análise de dados relacionados com ocorrências.
          </p>
        </div>

        <div class="card">
          <h3>04. Person Relations</h3>
          <p>
            Visualização de relações entre registos de pessoas.
          </p>
        </div>

        <div class="card">
          <h3>05. Vehicle R
